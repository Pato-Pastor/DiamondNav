+// DiamondNav: drive-bys (npcs/patches/0001-drive-bys-and-driving.patch).
+
+bool NPC::canDriveBy() const
+{
+	if (!isInVehicle())
+	{
+		return false;
+	}
+
+	if (WeaponInfo::get(weapon_).type != PlayerWeaponType_Bullet)
+	{
+		return false;
+	}
+
+	if (vehicleSeat_ == 0)
+	{
+		// GTA lets a driver fire only the sub-machine guns, sideways.
+		return weapon_ == PlayerWeapon_UZI || weapon_ == PlayerWeapon_MP5 || weapon_ == PlayerWeapon_TEC9;
+	}
+
+	// Passengers: any bullet weapon short of the heavy and sniper slots.
+	return weapon_ != PlayerWeapon_Sniper && weapon_ != PlayerWeapon_Minigun;
+}
+
+void NPC::updateDriveByKeys()
+{
+	if (!isInVehicle() || vehicleSeat_ != 0)
+	{
+		return;
+	}
+
+	// A driver: no aim key (in a car it is the handbrake). Look toward the target's side
+	// of the car instead, which is how GTA aims a driver's drive-by.
+	removeKey(Key::AIM);
+	removeKey(Key::LOOK_LEFT);
+	removeKey(Key::LOOK_RIGHT);
+	if (!aiming_ || !canDriveBy())
+	{
+		return;
+	}
+
+	float heading = glm::radians(getRotation().ToEuler().z);
+	Vector3 toTarget = aimAt_ - getPosition();
+	// GTA's forward for heading h is (-sin h, cos h); its right is (cos h, sin h).
+	float side = toTarget.x * glm::cos(heading) + toTarget.y * glm::sin(heading);
+	applyKey(side >= 0.0f ? Key::LOOK_RIGHT : Key::LOOK_LEFT);
+}
